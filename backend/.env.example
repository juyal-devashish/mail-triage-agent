# Copy to backend/.env (git-ignored). Names only here; never commit real values.

# Claude API key (or sign in with `ant auth login` instead)
ANTHROPIC_API_KEY=

# synthetic (default) or gmail
MTA_PROVIDER=
# Model and effort for triage (defaults: claude-opus-5-5, low)
MTA_MODEL=
MTA_EFFORT=
# Live calls allowed per triage run (default 10)
MTA_MAX_CALLS=
# Gmail: how many days of inbox to triage, and a cap on messages per sync
MTA_GMAIL_DAYS=
MTA_GMAIL_MAX_MESSAGES=
